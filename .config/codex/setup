#!/bin/sh

set -eu
umask 077

usage() {
    echo "usage: $0 [--install-only|--enable|--disable|--restart|--status|--update]" >&2
    exit 64
}

if [ "$#" -gt 1 ]; then
    usage
fi

action=${1:---install-only}
case $action in
    --install-only|--enable|--disable|--restart|--status|--update) ;;
    *) usage ;;
esac

os=$(uname -s)
case $os in
    Linux|Darwin) ;;
    *)
        echo "codex: unsupported service manager on $os" >&2
        exit 69
        ;;
esac

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_dir=$config_home/codex
unit_dir=$config_home/systemd/user
service=codex-remote-control.service
unit_template=$config_dir/systemd/$service
unit_link=$unit_dir/$service
label=io.codex.remote-control
plist_template=$config_dir/launchd/$label.plist
launch_agents_dir=$HOME/Library/LaunchAgents
plist_installed=$launch_agents_dir/$label.plist
codex_home=${CODEX_HOME:-"$HOME/.codex"}
codex_bin=$codex_home/packages/standalone/current/bin/codex

require_systemd() {
    if ! command -v systemctl >/dev/null 2>&1; then
        echo "codex: systemctl is required for Linux service actions" >&2
        exit 69
    fi
}

require_launchd() {
    if ! command -v launchctl >/dev/null 2>&1; then
        echo "codex: launchctl is required for macOS service actions" >&2
        exit 69
    fi
}

require_service_manager() {
    case $os in
        Linux) require_systemd ;;
        Darwin) require_launchd ;;
        *)
            echo "codex: unsupported service manager on $os" >&2
            exit 69
            ;;
    esac
}

install_codex() {
    if ! command -v curl >/dev/null 2>&1; then
        echo "codex: curl is required to install the standalone CLI" >&2
        exit 69
    fi

    installer=$(mktemp "${TMPDIR:-/tmp}/codex-install.XXXXXX")
    trap 'rm -f "$installer"' 0 1 2 15
    curl -fsSL https://chatgpt.com/codex/install.sh -o "$installer"
    # Keep installation independent of shell startup files. Including the
    # visible command directory makes the official installer skip profile
    # edits and hides stale package-manager installations from detection.
    PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin" \
        CODEX_NON_INTERACTIVE=1 \
        sh "$installer"
    rm -f "$installer"
    trap - 0 1 2 15

    if [ ! -x "$codex_bin" ]; then
        echo "codex: installer did not create $codex_bin" >&2
        exit 70
    fi
}

ensure_codex() {
    if [ ! -x "$codex_bin" ]; then
        install_codex
    fi
}

require_codex() {
    if [ ! -x "$codex_bin" ]; then
        echo "codex: standalone executable not found: $codex_bin" >&2
        echo "codex: run $0 --install-only" >&2
        exit 127
    fi
}

require_login() {
    if ! "$codex_bin" login status >/dev/null 2>&1; then
        echo "codex: device login is required before enabling remote control:" >&2
        echo "  $codex_bin login --device-auth" >&2
        exit 78
    fi
}

install_unit() {
    if [ ! -r "$unit_template" ]; then
        echo "codex: missing tracked unit template: $unit_template" >&2
        exit 66
    fi
    mkdir -p "$unit_dir"
    rm -f "$unit_link"
    ln -s "$unit_template" "$unit_link"
}

remove_unit() {
    rm -f "$unit_link"
}

install_plist() {
    if [ ! -r "$plist_template" ]; then
        echo "codex: missing tracked launchd template: $plist_template" >&2
        exit 66
    fi
    mkdir -p "$launch_agents_dir"
    install -m 600 "$plist_template" "$plist_installed"
}

remove_plist() {
    rm -f "$plist_installed"
}

launchd_domain() {
    printf 'gui/%s\n' "$(id -u)"
}

launchd_target() {
    printf '%s/%s\n' "$(launchd_domain)" "$label"
}

launchd_is_loaded() {
    launchctl print "$(launchd_target)" >/dev/null 2>&1
}

launchd_is_running() {
    print_out=$(launchctl print "$(launchd_target)" 2>/dev/null || true)
    case $print_out in
        *"state = running"*) return 0 ;;
        *) return 1 ;;
    esac
}

wait_for_launchd_unload() {
    target=$(launchd_target)
    attempts=0
    while launchctl print "$target" >/dev/null 2>&1; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 300 ]; then
            echo "codex: timed out waiting for launchd to unload $target" >&2
            exit 75
        fi
        sleep 0.1
    done
}

bootout_launchd() {
    target=$(launchd_target)
    if launchctl print "$target" >/dev/null 2>&1; then
        launchctl bootout "$target" || true
    fi
    wait_for_launchd_unload
}

bootstrap_launchd() {
    launchctl enable "$(launchd_target)" >/dev/null 2>&1 || true
    launchctl bootstrap "$(launchd_domain)" "$plist_installed"
}

remove_legacy_watcher() {
    systemctl --user disable --now codex-binary.path \
        codex-binary-restart.service >/dev/null 2>&1 || true
    rm -f "$unit_dir/codex-binary.path"
    rm -f "$unit_dir/codex-binary-restart.service"
}

wait_for_service_linux() {
    attempts=0
    while ! "$codex_bin" app-server daemon version >/dev/null 2>&1; do
        attempts=$((attempts + 1))
        if ! systemctl --user is-active --quiet "$service" || [ "$attempts" -ge 80 ]; then
            echo "codex: app-server did not become ready" >&2
            systemctl --user status "$service" --no-pager >&2 || true
            exit 75
        fi
        sleep 0.25
    done
}

wait_for_service_darwin() {
    attempts=0
    while ! "$codex_bin" app-server daemon version >/dev/null 2>&1; do
        attempts=$((attempts + 1))
        if ! launchd_is_running || [ "$attempts" -ge 80 ]; then
            echo "codex: app-server did not become ready" >&2
            launchctl print "$(launchd_target)" >&2 || true
            exit 75
        fi
        sleep 0.25
    done
}

service_is_running() {
    case $os in
        Linux) systemctl --user is-active --quiet "$service" ;;
        Darwin) launchd_is_running ;;
        *) return 1 ;;
    esac
}

request_graceful_restart() {
    case $os in
        Linux)
            if systemctl --user is-active --quiet "$service"; then
                # Codex handles SIGHUP by draining every running assistant turn before
                # exiting. Restart=always then launches the installed binary.
                systemctl --user kill --kill-who=main --signal=SIGHUP "$service"
                echo "codex: graceful restart requested; active turns will finish first"
            else
                systemctl --user start "$service"
                wait_for_service_linux
            fi
            ;;
        Darwin)
            if launchd_is_running; then
                # KeepAlive relaunches after Codex drains on SIGHUP. Never kickstart -k.
                launchctl kill SIGHUP "$(launchd_target)"
                echo "codex: graceful restart requested; active turns will finish first"
            else
                bootout_launchd
                bootstrap_launchd
                wait_for_service_darwin
            fi
            ;;
        *)
            echo "codex: unsupported service manager on $os" >&2
            exit 69
            ;;
    esac
}

restart_if_version_changed() {
    if ! service_is_running; then
        return
    fi

    version_json=$("$codex_bin" app-server daemon version 2>/dev/null || true)
    managed_version=$(printf '%s\n' "$version_json" |
        sed -n 's/.*"managedCodexVersion":"\([^"]*\)".*/\1/p')
    running_version=$(printf '%s\n' "$version_json" |
        sed -n 's/.*"appServerVersion":"\([^"]*\)".*/\1/p')

    if [ -n "$managed_version" ] && [ -n "$running_version" ] &&
        [ "$managed_version" != "$running_version" ]
    then
        request_graceful_restart
    fi
}

report_linger() {
    if command -v loginctl >/dev/null 2>&1; then
        current_user=$(id -un)
        linger=$(loginctl show-user "$current_user" -p Linger --value 2>/dev/null || true)
        if [ "$linger" != yes ]; then
            echo "codex: enable boot-time user services with:"
            echo "  loginctl enable-linger \"$current_user\""
        fi
    fi
}

enable_linux() {
    require_systemd
    ensure_codex
    require_login
    install_unit
    remove_legacy_watcher
    systemctl --user daemon-reload
    systemctl --user enable "$service"
    request_graceful_restart
    report_linger
}

disable_linux() {
    require_systemd
    systemctl --user disable --now "$service" >/dev/null 2>&1 || true
    remove_legacy_watcher
    remove_unit
    systemctl --user daemon-reload
}

restart_linux() {
    require_systemd
    require_codex
    require_login
    install_unit
    systemctl --user daemon-reload
    request_graceful_restart
}

status_linux() {
    require_systemd
    require_codex
    "$codex_bin" --version
    "$codex_bin" login status || true
    printf "unit installed:  %s\n" "$([ -L "$unit_link" ] && echo yes || echo no)"
    printf "service enabled: %s\n" "$(systemctl --user is-enabled "$service" 2>/dev/null || true)"
    printf "service active:  %s\n" "$(systemctl --user is-active "$service" 2>/dev/null || true)"
    systemctl --user status "$service" --no-pager || true
}

enable_darwin() {
    require_launchd
    ensure_codex
    require_login
    install_plist
    if launchd_is_running; then
        launchctl kill SIGHUP "$(launchd_target)"
        echo "codex: graceful restart requested; active turns will finish first"
    else
        bootout_launchd
        bootstrap_launchd
        wait_for_service_darwin
    fi
}

disable_darwin() {
    require_launchd
    bootout_launchd
    remove_plist
}

restart_darwin() {
    require_launchd
    require_codex
    require_login
    install_plist
    request_graceful_restart
}

status_darwin() {
    require_launchd
    require_codex
    "$codex_bin" --version
    "$codex_bin" login status || true
    printf "plist installed: %s\n" "$([ -f "$plist_installed" ] && echo yes || echo no)"
    printf "service loaded:  %s\n" "$(launchd_is_loaded && echo yes || echo no)"
    printf "service running: %s\n" "$(launchd_is_running && echo yes || echo no)"
    launchctl print "$(launchd_target)" 2>/dev/null || true
}

case $action in
    --install-only)
        ensure_codex
        "$codex_bin" --version
        ;;
    --update)
        require_service_manager
        install_codex
        restart_if_version_changed
        "$codex_bin" --version
        ;;
    --enable)
        case $os in
            Linux) enable_linux ;;
            Darwin) enable_darwin ;;
            *)
                echo "codex: unsupported service manager on $os" >&2
                exit 69
                ;;
        esac
        echo "codex: remote-control service enabled"
        ;;
    --disable)
        case $os in
            Linux) disable_linux ;;
            Darwin) disable_darwin ;;
            *)
                echo "codex: unsupported service manager on $os" >&2
                exit 69
                ;;
        esac
        echo "codex: remote-control service disabled and uninstalled"
        ;;
    --restart)
        case $os in
            Linux) restart_linux ;;
            Darwin) restart_darwin ;;
            *)
                echo "codex: unsupported service manager on $os" >&2
                exit 69
                ;;
        esac
        ;;
    --status)
        case $os in
            Linux) status_linux ;;
            Darwin) status_darwin ;;
            *)
                echo "codex: unsupported service manager on $os" >&2
                exit 69
                ;;
        esac
        ;;
esac
