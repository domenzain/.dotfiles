#!/bin/sh

set -eu
umask 077

usage() {
    echo "usage: $0 [--install-only|--enable|--disable|--restart|--status|--update]" >&2
    exit 64
}

if [ "$#" -gt 1 ]; then
    usage
fi

action=${1:---install-only}
case $action in
    --install-only|--enable|--disable|--restart|--status|--update) ;;
    *) usage ;;
esac

os=$(uname -s)
case $os in
    Linux) service_manager=systemd ;;
    Darwin) service_manager=launchd ;;
    *)
        echo "grok: unsupported service manager on $os" >&2
        exit 69
        ;;
esac

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_dir=$config_home/grok
unit_dir=$config_home/systemd/user
service=grok-agent.service
unit_template=$config_dir/systemd/$service
unit_link=$unit_dir/$service
label=io.grok.agent
launch_domain=gui/$(id -u)
launch_target=$launch_domain/$label
plist_template=$config_dir/launchd/$label.plist
plist_install=$HOME/Library/LaunchAgents/$label.plist
local_template=$config_dir/service.local.example
local_config=$config_dir/service.local
grok_home=${GROK_HOME:-"$HOME/.grok"}
grok_bin=${GROK_BIN:-"$grok_home/bin/grok"}
session_file=$grok_home/active_sessions.json
session_lock=$grok_home/active_sessions.lock
restart_marker=$grok_home/service-restart-required
service_was_active=0

require_systemd() {
    if ! command -v systemctl >/dev/null 2>&1; then
        echo "grok: systemctl is required for Linux service actions" >&2
        exit 69
    fi
}

require_launchd() {
    if ! command -v launchctl >/dev/null 2>&1; then
        echo "grok: launchctl is required for macOS service actions" >&2
        exit 69
    fi
}

require_service_manager() {
    case $service_manager in
        systemd) require_systemd ;;
        launchd) require_launchd ;;
    esac
}

require_jq() {
    if ! command -v jq >/dev/null 2>&1; then
        echo "grok: jq is required for safe update checks" >&2
        exit 69
    fi
}

install_grok() {
    if ! command -v curl >/dev/null 2>&1 || ! command -v bash >/dev/null 2>&1; then
        echo "grok: curl and bash are required to install the CLI" >&2
        exit 69
    fi

    installer=$(mktemp "${TMPDIR:-/tmp}/grok-install.XXXXXX")
    if ! curl -fsSL https://x.ai/cli/install.sh -o "$installer"; then
        rm -f "$installer"
        return 1
    fi
    if ! PATH="$grok_home/bin:/usr/local/bin:/usr/bin:/bin" \
        SHELL=/bin/false \
        GROK_BIN_DIR="$grok_home/bin" \
        GROK_CHANNEL=stable \
        bash "$installer"
    then
        rm -f "$installer"
        return 1
    fi
    rm -f "$installer"

    if [ ! -x "$grok_bin" ]; then
        echo "grok: installer did not create $grok_bin" >&2
        exit 70
    fi

    # Replacing the on-disk binary while a managed service still runs the old
    # image requires a later idle restart. Preserve a marker when we cannot
    # prove process/binary identity (especially on Darwin without /proc).
    if service_is_active; then
        mkdir -p "$grok_home"
        touch "$restart_marker"
    fi
}

ensure_grok() {
    if [ ! -x "$grok_bin" ]; then
        install_grok
    fi
}

require_grok() {
    if [ ! -x "$grok_bin" ]; then
        echo "grok: executable not found: $grok_bin" >&2
        echo "grok: run $0 --install-only" >&2
        exit 127
    fi
}

require_login() {
    require_jq
    if [ ! -r "$grok_home/auth.json" ] ||
        ! jq -e 'type == "object" and length > 0' "$grok_home/auth.json" >/dev/null 2>&1
    then
        echo "grok: device login is required before enabling the service:" >&2
        echo "  $grok_bin login --device-auth" >&2
        exit 78
    fi
}

ensure_local_config() {
    if [ ! -r "$local_template" ]; then
        echo "grok: missing tracked template: $local_template" >&2
        exit 66
    fi
    mkdir -p "$config_dir"
    chmod 700 "$config_dir"
    if [ ! -e "$local_config" ]; then
        install -m 600 "$local_template" "$local_config"
        echo "grok: created $local_config"
    else
        chmod 600 "$local_config"
        echo "grok: preserved existing $local_config"
    fi

    if ! grep -q '^GROK_AGENT_SECRET=' "$local_config"; then
        secret=$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
        printf '\nGROK_AGENT_SECRET=%s\n' "$secret" >>"$local_config"
        echo "grok: generated a stable private service secret"
    fi
}

install_unit() {
    if [ ! -r "$unit_template" ]; then
        echo "grok: missing tracked unit template: $unit_template" >&2
        exit 66
    fi
    mkdir -p "$unit_dir"
    rm -f "$unit_link"
    ln -s "$unit_template" "$unit_link"
}

remove_unit() {
    rm -f "$unit_link"
}

install_plist() {
    if [ ! -r "$plist_template" ]; then
        echo "grok: missing tracked LaunchAgent template: $plist_template" >&2
        exit 66
    fi
    mkdir -p "$HOME/Library/LaunchAgents"
    install -m 600 "$plist_template" "$plist_install"
}

remove_plist() {
    rm -f "$plist_install"
}

remove_legacy_watcher() {
    systemctl --user disable --now grok-binary.path \
        grok-binary-restart.service >/dev/null 2>&1 || true
    rm -f "$unit_dir/grok-binary.path"
    rm -f "$unit_dir/grok-binary-restart.service"
}

service_is_active() {
    case $service_manager in
        systemd)
            command -v systemctl >/dev/null 2>&1 || return 1
            systemctl --user is-active --quiet "$service"
            ;;
        launchd)
            command -v launchctl >/dev/null 2>&1 || return 1
            out=$(launchctl print "$launch_target" 2>/dev/null) || return 1
            printf '%s\n' "$out" | grep -q 'state = running' || return 1
            pid=$(printf '%s\n' "$out" | awk '/^[[:space:]]*pid = / { print $3; exit }')
            case $pid in
                ''|0|*[!0-9]*) return 1 ;;
            esac
            kill -0 "$pid" 2>/dev/null
            ;;
        *) return 1 ;;
    esac
}

service_is_loaded() {
    case $service_manager in
        systemd)
            command -v systemctl >/dev/null 2>&1 || return 1
            systemctl --user is-enabled --quiet "$service" 2>/dev/null
            ;;
        launchd)
            command -v launchctl >/dev/null 2>&1 || return 1
            launchctl print "$launch_target" >/dev/null 2>&1
            ;;
        *) return 1 ;;
    esac
}

service_main_pid() {
    case $service_manager in
        systemd)
            systemctl --user show "$service" -p MainPID --value 2>/dev/null || true
            ;;
        launchd)
            out=$(launchctl print "$launch_target" 2>/dev/null) || {
                echo 0
                return 0
            }
            printf '%s\n' "$out" | awk '/^[[:space:]]*pid = / { print $3; exit }'
            ;;
        *)
            echo 0
            ;;
    esac
}

wait_for_launchd_unload() {
    attempts=0
    while launchctl print "$launch_target" >/dev/null 2>&1; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 300 ]; then
            echo "grok: timed out waiting for launchd to unload $launch_target" >&2
            exit 75
        fi
        sleep 0.1
    done
}

bootout_launchd() {
    if launchctl print "$launch_target" >/dev/null 2>&1; then
        launchctl bootout "$launch_target" >/dev/null 2>&1 || true
    fi
    wait_for_launchd_unload
}

bootstrap_launchd() {
    if [ ! -r "$plist_install" ]; then
        echo "grok: missing installed LaunchAgent: $plist_install" >&2
        exit 66
    fi
    # Residual Background Task Management state can otherwise make a fresh
    # bootstrap return a generic I/O error.
    launchctl enable "$launch_target" >/dev/null 2>&1 || true
    bootout_launchd
    attempts=0
    while :; do
        if err=$(launchctl bootstrap "$launch_domain" "$plist_install" 2>&1); then
            return 0
        fi
        case $err in
            *"already bootstrapped"*|*"service already loaded"*)
                return 0
                ;;
        esac
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 3 ]; then
            printf '%s\n' "$err" >&2
            return 1
        fi
        bootout_launchd
        sleep 0.2
    done
}

start_service() {
    case $service_manager in
        systemd)
            systemctl --user start "$service"
            ;;
        launchd)
            bootstrap_launchd
            ;;
    esac
}

stop_service() {
    case $service_manager in
        systemd)
            systemctl --user stop "$service"
            ;;
        launchd)
            bootout_launchd
            ;;
    esac
}

wait_for_service() {
    attempts=0
    while ! service_is_active; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 40 ]; then
            echo "grok: service did not become active" >&2
            case $service_manager in
                systemd) systemctl --user status "$service" --no-pager >&2 || true ;;
                launchd) launchctl print "$launch_target" >&2 || true ;;
            esac
            exit 75
        fi
        sleep 0.25
    done
    sleep 0.5
    if ! service_is_active; then
        echo "grok: service exited during startup" >&2
        case $service_manager in
            systemd) systemctl --user status "$service" --no-pager >&2 || true ;;
            launchd) launchctl print "$launch_target" >&2 || true ;;
        esac
        exit 75
    fi
}

acquire_session_lock() {
    mkdir -p "$grok_home"
    exec 9>>"$session_lock"
    if command -v flock >/dev/null 2>&1; then
        if ! flock -w 5 9; then
            exec 9>&-
            echo "grok: session registry is busy; deferring service change"
            return 1
        fi
    elif command -v lockf >/dev/null 2>&1; then
        if ! lockf -s -t 5 9; then
            exec 9>&-
            echo "grok: session registry is busy; deferring service change"
            return 1
        fi
    else
        exec 9>&-
        echo "grok: flock or lockf is required for session registry locking" >&2
        exit 69
    fi
}

release_session_lock() {
    if command -v flock >/dev/null 2>&1; then
        flock -u 9 2>/dev/null || true
    fi
    exec 9>&-
}

has_live_sessions() {
    if [ ! -r "$session_file" ]; then
        return 1
    fi
    if ! count=$(jq -r 'if type == "array" then length else error("not an array") end' "$session_file" 2>/dev/null); then
        echo "grok: cannot validate active_sessions.json; treating Grok as busy" >&2
        return 0
    fi
    if [ "$count" -eq 0 ]; then
        return 1
    fi

    pids=$(jq -r '.[] | (.pid // "unknown") | tostring' "$session_file")
    for pid in $pids; do
        case $pid in
            ''|*[!0-9]*)
                echo "grok: active session has no valid PID; treating Grok as busy" >&2
                return 0
                ;;
        esac
        if kill -0 "$pid" 2>/dev/null; then
            echo "grok: active task registered by PID $pid; update deferred"
            return 0
        fi
    done
    return 1
}

binary_is_stale() {
    if ! service_is_active; then
        return 1
    fi
    main_pid=$(service_main_pid)
    case $main_pid in
        ''|0|*[!0-9]*) return 1 ;;
    esac

    case $service_manager in
        systemd)
            # Compare the running image inode to the installed binary.
            running_id=$(stat -Lc '%d:%i' "/proc/$main_pid/exe" 2>/dev/null || true)
            installed_id=$(stat -Lc '%d:%i' "$grok_bin" 2>/dev/null || true)
            [ -n "$running_id" ] && [ -n "$installed_id" ] && [ "$running_id" != "$installed_id" ]
            ;;
        launchd)
            # Darwin has no /proc/<pid>/exe. Prefer txt-path inode compare when
            # lsof is available; otherwise preserve the restart marker path and
            # never invent a false-negative that skips a needed restart.
            if ! command -v lsof >/dev/null 2>&1; then
                return 1
            fi
            running_path=$(lsof -a -p "$main_pid" -d txt -Fn 2>/dev/null |
                awk '/^n\// { print substr($0, 2); exit }')
            if [ -z "$running_path" ]; then
                return 1
            fi
            running_id=$(stat -f '%d:%i' "$running_path" 2>/dev/null || true)
            installed_id=$(stat -f '%d:%i' "$grok_bin" 2>/dev/null || true)
            if [ -z "$installed_id" ] && [ -L "$grok_bin" ]; then
                installed_id=$(stat -f '%d:%i' "$(readlink "$grok_bin")" 2>/dev/null || true)
            fi
            [ -n "$running_id" ] && [ -n "$installed_id" ] && [ "$running_id" != "$installed_id" ]
            ;;
        *)
            return 1
            ;;
    esac
}

stop_when_idle() {
    require_jq
    if ! acquire_session_lock; then
        return 1
    fi
    if has_live_sessions; then
        release_session_lock
        return 1
    fi

    service_was_active=0
    if service_is_active; then
        service_was_active=1
        # Hold Grok's own registry lock through stop so a new task cannot race
        # the idle check and receive a termination signal.
        if ! stop_service; then
            release_session_lock
            start_service >/dev/null 2>&1 || true
            return 1
        fi
    fi
    release_session_lock
}

restore_service() {
    if [ "$service_was_active" -eq 1 ]; then
        start_service || true
    fi
}

restart_when_idle() {
    touch "$restart_marker"
    if ! stop_when_idle; then
        echo "grok: restart remains pending and will be retried hourly"
        return 0
    fi
    trap 'restore_service' 0 1 2 15
    start_service
    wait_for_service
    service_was_active=0
    rm -f "$restart_marker"
    trap - 0 1 2 15
}

update_grok() {
    require_grok
    require_service_manager
    require_jq

    if ! check_json=$("$grok_bin" update --check --json); then
        echo "grok: update check failed" >&2
        return 1
    fi
    if ! printf '%s\n' "$check_json" | jq -e . >/dev/null 2>&1; then
        echo "grok: update check returned invalid JSON" >&2
        return 1
    fi
    check_error=$(printf '%s\n' "$check_json" | jq -r '.error // empty')
    if [ -n "$check_error" ]; then
        echo "grok: update check failed: $check_error" >&2
        return 1
    fi
    update_available=$(printf '%s\n' "$check_json" | jq -r '.updateAvailable // false')

    stale=false
    if binary_is_stale || [ -e "$restart_marker" ]; then
        stale=true
    fi
    if [ "$update_available" != true ] && [ "$stale" != true ]; then
        current=$(printf '%s\n' "$check_json" | jq -r '.currentVersion // "unknown"')
        echo "grok: $current is up to date"
        return 0
    fi

    if [ "$update_available" = true ]; then
        # Remember that an update/restart is owed if a live session blocks us.
        mkdir -p "$grok_home"
        touch "$restart_marker"
    fi

    if ! stop_when_idle; then
        echo "grok: update/restart deferred until no task is active"
        return 0
    fi
    trap 'restore_service' 0 1 2 15

    if [ "$update_available" = true ]; then
        install_grok
    fi
    if [ "$service_was_active" -eq 1 ]; then
        start_service
        wait_for_service
    fi
    service_was_active=0
    rm -f "$restart_marker"
    trap - 0 1 2 15
    "$grok_bin" --version
}

report_linger() {
    if [ "$service_manager" != systemd ]; then
        return 0
    fi
    if command -v loginctl >/dev/null 2>&1; then
        current_user=$(id -un)
        linger=$(loginctl show-user "$current_user" -p Linger --value 2>/dev/null || true)
        if [ "$linger" != yes ]; then
            echo "grok: enable boot-time user services with:"
            echo "  loginctl enable-linger \"$current_user\""
        fi
    fi
}

enable_linux() {
    require_systemd
    ensure_grok
    require_login
    ensure_local_config
    install_unit
    remove_legacy_watcher
    systemctl --user daemon-reload
    systemctl --user enable "$service"
    if service_is_active; then
        restart_when_idle
    else
        start_service
        wait_for_service
    fi
    report_linger
}

disable_linux() {
    require_systemd
    systemctl --user disable --now "$service" >/dev/null 2>&1 || true
    remove_legacy_watcher
    remove_unit
    rm -f "$restart_marker"
    systemctl --user daemon-reload
}

restart_linux() {
    require_systemd
    require_grok
    ensure_local_config
    install_unit
    systemctl --user daemon-reload
    restart_when_idle
}

status_linux() {
    require_systemd
    require_grok
    "$grok_bin" --version
    printf "unit installed:  %s\n" "$([ -L "$unit_link" ] && echo yes || echo no)"
    printf "service enabled: %s\n" "$(systemctl --user is-enabled "$service" 2>/dev/null || true)"
    printf "service active:  %s\n" "$(systemctl --user is-active "$service" 2>/dev/null || true)"
    printf "restart pending: %s\n" "$([ -e "$restart_marker" ] && echo yes || echo no)"
    systemctl --user status "$service" --no-pager || true
}

enable_macos() {
    require_launchd
    ensure_grok
    require_login
    ensure_local_config
    install_plist
    if service_is_active; then
        restart_when_idle
    else
        start_service
        wait_for_service
    fi
}

disable_macos() {
    require_launchd
    bootout_launchd
    remove_plist
    rm -f "$restart_marker"
}

restart_macos() {
    require_launchd
    require_grok
    ensure_local_config
    install_plist
    restart_when_idle
}

status_macos() {
    require_launchd
    require_grok
    "$grok_bin" --version
    printf "plist installed: %s\n" "$([ -f "$plist_install" ] && echo yes || echo no)"
    printf "service loaded:  %s\n" "$(service_is_loaded && echo yes || echo no)"
    printf "service active:  %s\n" "$(service_is_active && echo yes || echo no)"
    printf "restart pending: %s\n" "$([ -e "$restart_marker" ] && echo yes || echo no)"
    launchctl print "$launch_target" 2>/dev/null || true
}

case $action in
    --install-only)
        ensure_grok
        "$grok_bin" --version
        ;;
    --update)
        update_grok
        ;;
    --enable)
        case $service_manager in
            systemd) enable_linux ;;
            launchd) enable_macos ;;
        esac
        echo "grok: agent service enabled"
        ;;
    --disable)
        case $service_manager in
            systemd) disable_linux ;;
            launchd) disable_macos ;;
        esac
        echo "grok: agent service disabled and uninstalled"
        ;;
    --restart)
        case $service_manager in
            systemd) restart_linux ;;
            launchd) restart_macos ;;
        esac
        ;;
    --status)
        case $service_manager in
            systemd) status_linux ;;
            launchd) status_macos ;;
        esac
        ;;
esac
