#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
lock_dir=${XDG_CACHE_HOME:-"$HOME/.cache"}/agent-services
mkdir -p "$lock_dir"

# Advisory lock on fd 9. Prefer flock; otherwise lockf -s -t N 9.
# Closing fd 9 releases either. Missing both is a hard error — never
# pretend another update is active when the lock tools are absent.
exec 9>>"$lock_dir/update.lock"
if command -v flock >/dev/null 2>&1; then
    if ! flock -n 9; then
        echo "agent-services: another update run is active; skipping" >&2
        exit 0
    fi
elif command -v lockf >/dev/null 2>&1; then
    if ! lockf -s -t 0 9; then
        echo "agent-services: another update run is active; skipping" >&2
        exit 0
    fi
else
    echo "agent-services: neither flock nor lockf is available; cannot serialize updates" >&2
    exit 69
fi

failures=0
run_update() {
    local name=$1
    local helper=$2

    echo
    echo "==> Checking $name"
    if ! "$helper" --update; then
        echo "agent-services: $name update failed; the next hourly run will retry" >&2
        failures=$((failures + 1))
    fi
}

# Codex remains last because an already-running app-server may schedule a
# graceful restart after the current assistant turn drains.
run_update Pi "$config_home/pi/setup"
run_update "Oh My Pi" "$config_home/omp/setup"
run_update AgentsView "$config_home/agentsview/setup"
run_update Grok "$config_home/grok/setup"
run_update Codex "$config_home/codex/setup"

# Only inspect an opted-in executor; never interrupt its active tasks.
if [[ "$(uname -s)" == Linux && -x "$config_home/codex-executor/setup" ]]; then
    run_update "Codex dot executor" "$config_home/codex-executor/setup"
fi

if (( failures > 0 )); then
    echo "agent-services: $failures update check(s) failed" >&2
    exit 1
fi

echo
echo "agent-services: hourly update check complete"
